# Copy to your hosting provider's environment settings. Never commit real secrets.
# Required: Firebase Admin service account JSON (single-line JSON).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Exact origins of your deployed static website, comma-separated.
ALLOWED_ORIGINS=https://rdx690.github.io
# Persistent volume mount path. Mount a Koyeb volume at /data and use this path.
DATA_DIR=/data
PORT=8000
LOG_LEVEL=info
# Optional HTTPS image sent with .menu
BOT_PICTURE_URL=
