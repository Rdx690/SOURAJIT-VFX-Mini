# Copy this file to .env locally. Never commit your real .env.
BOT_NAME=𝐒ꭷᴜʀᴀᴊɪᴛ メ 𝐕𝐅𝐗
PREFIX=.
OWNER_NUMBER=91XXXXXXXXXX
PAIRING_NUMBER=91XXXXXXXXXX
SESSION_DIR=session
AUTO_READ=false
AUTO_STATUS_VIEW=false
LOG_LEVEL=silent
PORT=3000

# Optional integrations (configure only trusted HTTPS providers).
DOWNLOAD_API_URL=

# Optional integrations (not used by the starter bot core yet).
MONGODB_URI=
AI_API_KEY=
STABILITY_API_KEY=

# Keep public pairing commands disabled; this starter has no public pairing command.
ALLOW_PUBLIC_PAIR_COMMAND=false
